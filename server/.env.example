# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/liveops

# JWT Authentication Secrets (Replace with secure random keys in production)
JWT_ACCESS_SECRET=change_this_to_a_secure_access_token_secret_key_32bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_secure_refresh_token_secret_key_32bytes
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic Claude API Integration
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
